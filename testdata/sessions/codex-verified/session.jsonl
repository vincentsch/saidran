*testing.T) {\n\tgot, err := ParseList(\"1; 2; 3\")\n\tif err != nil || len(got) != 3 {\n\t\tt.Fatalf(\"ParseList with semicolons = %v, %v; want 3 numbers\", got, err)\n\t}\n}\n", "exit_code": 0, "duration": {"secs": 0, "nanos": 8147}}, "started_at_ms": 1792511447501, "completed_at_ms": 1792511447501}}
