", got, err)\\n\\t}\\n}\\n\\nfunc TestParseListSemicolons(t *testing.T) {\\n\\tgot, err := ParseList(\\\"1; 2; 3\\\")\\n\\tif err != nil || len(got) != 3 {\\n\\t\\tt.Fatalf(\\\"ParseList with semicolons = %v, %v; want 3 numbers\\\", got, err)\\n\\t}\\n}\\n\"}}}"}, {"type": "input_text", "text": "{\"i\":1,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"161c7a\",\"wall_time_seconds\":0.054021032,\"exit_code\":1,\"original_token_count\":71,\"output\":\"--- FAIL: TestAverage (0.00s)\\n    stats_test.go:8: Average = 6, want 4\\n--- FAIL: TestParseListSemicolons (0.00s)\\n    stats_test.go:28: ParseList with semicolons = [], strconv.ParseFloat: parsing \\\"1; 2; 3\\\": invalid syntax; want 3 numbers\\nFAIL\\nFAIL\\texample.com/gocalc/calc\\t0.002s\\nFAIL\\n\"}}}"}, {"type": "input_text", "text": "{\"i\":2,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"07c085\",\"wall_time_seconds\":0.000006571,\"exit_code\":0,\"original_token_count\":0,\"output\":\"\"}}}"}], "internal_chat_message_metadata_passthrough": {"turn_id": "01a15a01-e2be-79c3-a912-178c03b837d5", "create_time": 1792511447.6804}}, "metadata": {"client_authored": false, "fallback_token_limit_override": 12000}}
